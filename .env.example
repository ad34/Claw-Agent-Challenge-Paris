# Copy to .env and fill in. Never commit .env.

# NVIDIA API key (https://build.nvidia.com → Get API Key): Nemotron Super (planning) and Nemotron Omni (visual critique)
NVIDIA_API_KEY=

# Telegram bot created with @BotFather, and the chat that receives the morning digest (run: npm run chat-id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Meshy API key (https://www.meshy.ai → API): product photo or description → textured 3D model
MESHY_API_KEY=

# Local time of the morning digest on Telegram
DIGEST_AT=07:30

# Optional
# BLENDER_PATH=C:\Program Files\Blender Foundation\Blender 5.2\blender.exe
# NVIDIA_RPM=30          # self-imposed cap on NVIDIA API calls per minute (account limit: 40)
# STUDIO_DIR=            # where renders and the SQLite database live (default: ~/.night-studio)
# API_PORT=8787          # local API used by the desktop UI
